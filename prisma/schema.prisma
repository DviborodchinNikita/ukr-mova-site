generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(ADMIN)
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  ADMIN
  STUDENT
}

model SiteSettings {
  id              String  @id @default("main")
  siteName        String  @default("Освітній сайт")
  teacherName     String  @default("")
  welcomeTitle    String  @default("Вітаю на освітньому сайті!")
  welcomeText     String  @default("")
  aboutText       String  @default("")
  teacherPhoto    String?
  education       String?
  experience      String?
  credo           String?
  achievements    String?
  certificates    String?
  contactEmail    String?
  contactPhone    String?
  socialLinks     String?
}

model Video {
  id          String    @id @default(cuid())
  title       String
  description String?
  classLevel  String?
  topic       String?
  videoType   VideoType @default(YOUTUBE)
  videoUrl    String?
  videoFile   String?
  thumbnail   String?
  publishedAt DateTime?
  status      Status    @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum VideoType {
  YOUTUBE
  FILE
}

enum Status {
  DRAFT
  PUBLISHED
}

model Presentation {
  id          String   @id @default(cuid())
  title       String
  description String?
  classLevel  String?
  topic       String?
  fileType    String
  fileUrl     String
  publishedAt DateTime?
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Material {
  id          String           @id @default(cuid())
  title       String
  description String?
  classLevel  String?
  topic       String?
  category    MaterialCategory
  fileType    String?
  fileUrl     String?
  externalUrl String?
  publishedAt DateTime?
  status      Status           @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum MaterialCategory {
  PDF
  DOCX
  TABLE
  NOTES
  EXERCISE
  TEST
  METHODOLOGY
  LINK
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  image       String?
  publishedAt DateTime?
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}